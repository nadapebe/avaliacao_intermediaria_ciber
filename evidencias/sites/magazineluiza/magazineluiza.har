      "text": "{\"operationName\":\"adsItemsQuery\",\"variables\":{\"item_skipFinancialServices\":false,\"banners\":[{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_hypertop_Ads_small\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_tv\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_informatica\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_moveis\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_celulares\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_todosdepartamentos\"},{\"categories\":[],\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_menu_Ads_eletrodomesticos\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Promo_large_carrossel_p1\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Promo_large_carrossel_p2\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_large_carrossel_p3\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_large_carrossel_p4\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_large_carrossel_p5\"},{\"consumer\":\"desktop\",\"limit\":5,\"slot\":\"desk_home_large_carrossel_p6_10\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_medium\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_superior_1\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_superior_2\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_superior_3\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_meio_4\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_meio_5\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_meio_6\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_final_7\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_final_8\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Ads_trio_final_9\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desktop_magaluempresas\"},{\"consumer\":\"desktop\",\"limit\":1,\"slot\":\"desk_home_Promo_micro\"}],\"metadata\":{\"channelCode\":\"WEB\",\"isLoyalty\":false,\"partnerId\":\"\"},\"omitProductIds\":[],\"zipcode\":\"[REMOVIDO]\"},\"query\":\"query adsItemsQuery($metadata: MetadataInput!, $banners: [AdsBannerInput!], $products: [AdsProductInput!], $zipcode: String, $omitProductIds: [String!], $offerOptions: OfferOptionsInput, $item_skipFinancialServices: Boolean = false) {\\n  ads(\\n    input: {metadata: $metadata, banners: $banners, products: $products, zipcode: $zipcode, omitProductIds: $omitProductIds}\\n  ) {\\n    banners {\\n      campaignId\\n      redirectUrl\\n      imageUrl\\n      trackId\\n      slot\\n      __typename\\n    }\\n    items {\\n      trackId\\n      campaignId\\n      slot\\n      item {\\n        ...item\\n        __typename\\n      }\\n      __typename\\n    }\\n    fillrates {\\n      eventId\\n      placement\\n      received {\\n        serverAdsAmount\\n        __typename\\n      }\\n      requested {\\n        categories\\n        serverAdsAmount\\n        skus\\n        __typename\\n      }\\n      slotId\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment item on Item {\\n  adsSellerId\\n  ads {\\n    id\\n    sponsored\\n    __typename\\n  }\\n  attributes {\\n    ...attributes_itemAttributes\\n    __typename\\n  }\\n  available\\n  brand {\\n    ...brand_itemBrand\\n    __typename\\n  }\\n  parentMatchingUuid\\n  category {\\n    ...category_itemCategory\\n    __typename\\n  }\\n  subcategory {\\n    ...subcategory_itemSubcategory\\n    __typename\\n  }\\n  shippingTag(shippingTagRequest: {location: {zipCode: $zipcode}}) {\\n    cost\\n    time\\n    complement\\n    __typename\\n  }\\n  id\\n  image\\n  offerId\\n  path\\n  title\\n  offers(options: $offerOptions) {\\n    ...offers_itemOffers\\n    __typename\\n  }\\n  rating {\\n    ...rating_itemRating\\n    __typename\\n  }\\n  tags\\n  __typename\\n}\\n\\nfragment attributes_itemAttributes on ItemAttribute {\\n  current\\n  label\\n  type\\n  values {\\n    available\\n    image\\n    path\\n    value\\n    variationId\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment brand_itemBrand on ItemBrand {\\n  label\\n  slug\\n  __typename\\n}\\n\\nfragment category_itemCategory on ItemCategory {\\n  id\\n  name\\n  url\\n  subcategories {\\n    id\\n    name\\n    url\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment subcategory_itemSubcategory on ItemSubCategory {\\n  id\\n  name\\n  url\\n  __typename\\n}\\n\\nfragment offers_itemOffers on ItemOffer {\\n  variationId\\n  price\\n  listPrice\\n  currency\\n  exchangeRate\\n  idExchangeRate\\n  originalPriceForeign\\n  bestPrice {\\n    discount\\n    paymentMethodDescription\\n    paymentMethodId\\n    totalAmount\\n    __typename\\n  }\\n  bestInstallmentPlan {\\n    discount\\n    installment\\n    installmentAmount\\n    interestAmount\\n    paymentMethodDescription\\n    paymentMethodId\\n    totalAmount\\n    __typename\\n  }\\n  paymentMethods {\\n    id\\n    installmentPlans {\\n      discount\\n      installment\\n      installmentAmount\\n      interestAmount\\n      totalAmount\\n      __typename\\n    }\\n    __typename\\n  }\\n  restrictions {\\n    maxCheckoutQuantity\\n    timerStartDate\\n    timerEndDate\\n    __typename\\n  }\\n  seller {\\n    address {\\n      address\\n      city\\n      complement\\n      country\\n      district\\n      number\\n      state\\n      zipcode\\n      __typename\\n    }\\n    tagRanking\\n    available\\n    deliveryDescription\\n    deliveryId\\n    description\\n    documentNumber\\n    id\\n    isActive\\n    isChatEnabled\\n    isIpdv\\n    isQuestionsAndAnswersEnabled\\n    legalName\\n    name\\n    regulatoryData {\\n      anvisa {\\n        items\\n        notApply\\n        __typename\\n      }\\n      mapa {\\n        items\\n        notApply\\n        __typename\\n      }\\n      __typename\\n    }\\n    sellerSince\\n    sellsToCompany\\n    shippingDocumentNumber\\n    sku\\n    stats {\\n      answerRate {\\n        message\\n        status\\n        __typename\\n      }\\n      deliveryRate {\\n        message\\n        status\\n        __typename\\n      }\\n      score\\n      totalSales\\n      __typename\\n    }\\n    tags {\\n      action {\\n        type\\n        url\\n        __typename\\n      }\\n      backgroundColor\\n      code\\n      discountType\\n      discountValue\\n      endDate\\n      icon\\n      iconProperties {\\n        width\\n        height\\n        position\\n        __typename\\n      }\\n      layout\\n      message\\n      startDate\\n      textColor\\n      type\\n      version\\n      __typename\\n    }\\n    __typename\\n  }\\n  badges {\\n    container\\n    imageUrl\\n    position\\n    slug\\n    text\\n    tooltip\\n    __typename\\n  }\\n  promotions {\\n    id\\n    description\\n    benefit\\n    subBenefit\\n    benefitType\\n    benefitValue\\n    benefitPrice\\n    benefitBestPrice\\n    __typename\\n  }\\n  financialServices @skip(if: $item_skipFinancialServices) {\\n    id\\n    description\\n    offers {\\n      campaignId\\n      description\\n      id\\n      price\\n      treeId\\n      wageCompensation {\\n        amount\\n        percentage\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  eligibleService {\\n    enabled\\n    __typename\\n  }\\n  dimensions {\\n    depth\\n    height\\n    weight\\n    width\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment rating_itemRating on Rating {\\n  count\\n  score\\n  __typename\\n}\"}"
     }
