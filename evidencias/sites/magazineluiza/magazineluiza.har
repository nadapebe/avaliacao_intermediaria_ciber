     "headersSize": 6472,
     "postData": {
      "mimeType": "application/json",
      "params": [],
      "text": "{\"operationName\":\"showcaseQuery\",\"variables\":{\"includePagination\":false,\"toggleWishlist\":true,\"isSourceProductAds\":false,\"isLoyalty\":false,\"customerId\":\"[REMOVIDO]\",\"filters\":[{\"type\":\"page\",\"values\":\"home\"}],\"pageId\":\"Woo6TvcBFf\",\"placeId\":\"MjPNXPzc9y\",\"trackId\":\"[REMOVIDO]\",\"zipcode\":\"[REMOVIDO]\"},\"query\":\"query showcaseQuery($showcaseId: String, $customerId: String, $placeId: String, $pageId: String, $partnerId: String, $pmdPromoter: String, $storeId: String, $productId: String, $filters: [FilterInput], $includePagination: Boolean = true, $toggleWishlist: Boolean = true, $zipcode: String, $isSourceProductAds: Boolean = false, $trackId: String, $isLoyalty: Boolean = false) {\\n  recommendation(\\n    recommendationRequest: {customerId: $customerId, pageId: $pageId, placeId: $placeId, productId: $productId, metadata: {partnerId: $partnerId, trackId: $trackId, loyaltyParams: {pmdPromoter: $pmdPromoter, storeId: $storeId}, isLoyalty: $isLoyalty}, filters: $filters, searchRequest: {location: {zipCode: $zipcode}}, isSourceProductAds: $isSourceProductAds}\\n  ) {\\n    dynamic(showcaseId: $showcaseId) {\\n      id\\n      title\\n      type\\n      designTokenId\\n      products {\\n        ...product\\n        isOnWishlist @include(if: $toggleWishlist)\\n        shippingTag {\\n          cost\\n          time\\n          complement\\n          __typename\\n        }\\n        __typename\\n      }\\n      highlight {\\n        ...product\\n        shippingTag {\\n          cost\\n          time\\n          complement\\n          __typename\\n        }\\n        __typename\\n      }\\n      button {\\n        label\\n        action\\n        __typename\\n      }\\n      pagination {\\n        ...showcasePagination @include(if: $includePagination)\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment product on Product {\\n  id\\n  adsSellerId\\n  variationId\\n  title\\n  description\\n  image\\n  available\\n  url\\n  path\\n  reference\\n  offerTags\\n  restrictions\\n  price {\\n    paymentMethodDescription\\n    price\\n    fullPrice\\n    bestPrice\\n    discount\\n    currency\\n    __typename\\n  }\\n  installment {\\n    paymentMethodDescription\\n    quantity\\n    amount\\n    totalAmount\\n    __typename\\n  }\\n  rating {\\n    count\\n    score\\n    __typename\\n  }\\n  badges {\\n    text\\n    imageUrl\\n    container\\n    position\\n    tooltip\\n    __typename\\n  }\\n  seller {\\n    ...seller\\n    __typename\\n  }\\n  brand {\\n    ...brand\\n    __typename\\n  }\\n  category {\\n    ...productCategory\\n    __typename\\n  }\\n  subcategory {\\n    ...subcategory\\n    __typename\\n  }\\n  attributes {\\n    ...attributes\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment seller on Seller {\\n  id\\n  sku\\n  description\\n  category\\n  deliveryId\\n  deliveryDescription\\n  restrictions\\n  details {\\n    id\\n    legalName\\n    documentNumber\\n    shippingDocumentNumber\\n    score\\n    sellerSince\\n    totalSales\\n    deliveryRate {\\n      message\\n      status\\n      __typename\\n    }\\n    answerRate {\\n      message\\n      status\\n      __typename\\n    }\\n    address {\\n      address\\n      number\\n      complement\\n      district\\n      city\\n      state\\n      country\\n      zipcode\\n      __typename\\n    }\\n    regulatoryData {\\n      mapa {\\n        notApply\\n        items\\n        __typename\\n      }\\n      anvisa {\\n        notApply\\n        items\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  tags {\\n    code\\n    discountType\\n    discountValue\\n    endDate\\n    message\\n    type\\n    version\\n    action {\\n      type\\n      url\\n      __typename\\n    }\\n    __typename\\n  }\\n  isChatEnabled\\n  __typename\\n}\\n\\nfragment brand on Brand {\\n  label\\n  slug\\n  __typename\\n}\\n\\nfragment productCategory on ProductCategory {\\n  id\\n  name\\n  __typename\\n}\\n\\nfragment subcategory on ProductCategory {\\n  id\\n  name\\n  __typename\\n}\\n\\nfragment attributes on Attribute {\\n  type\\n  label\\n  value\\n  current\\n  values\\n  __typename\\n}\\n\\nfragment showcasePagination on ShowCasePagination {\\n  cursor\\n  next\\n  previous\\n  __typename\\n}\"}"
