          "cookies": [],
          "content": {
            "mimeType": "text/html; charset=UTF-8",
            "size": 704,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n        <title>Request blocking test page</title>\n\n        <script src='./main.js' defer></script>\n        <link href='./style.css' rel='stylesheet'></link>\n    </head>\n    <body>\n        <p><a href=\"../../\">[Home]</a> ↣ <a href=\"../\">[Privacy Protections Tests]</a> ↣ <strong>[Request Blocking Test Page]</strong></p>\n\n        <p>This page tests if different types of requests, made using various browser mechanisms, are getting blocked.</p>\n        <p>To test your request blocking solution please add <storng>bad.third-party.site</storng> domain to your blocklist.</p>\n\n        <button id='start'>Start the test</button>\n        <button id='download' disabled='disabled'>Download the results</button>\n\n        <ul>\n            <li class='category-html'>HTML\n                <ul>\n                </ul>\n            </li>\n            <li class='category-css'>CSS\n                <ul>\n                </ul>\n            </li>\n            <li class='category-js'>JS\n                <ul>\n                </ul>\n            </li>\n            <li class='category-other'>Other\n                <ul>\n                </ul>\n            </li>\n        </ul>\n\n        <p><strong>Legend:</strong></p>\n        <ul>\n            <li><div class='status loaded'></div> - request has loaded</li>\n            <li><div class='status'></div> - request hasn't loaded</li>\n            <li><div class='status failed'></div> - request failed (e.g. due to being blocked)</li>\n        </ul>\n\n        <div id='debug'>\n            Debug data:\n        </div>\n    </body>\n</html>"
          },
