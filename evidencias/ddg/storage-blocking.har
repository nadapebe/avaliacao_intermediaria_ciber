      "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Storage blocking test page</title>\n\n    <script src='/helpers/idb-wrapper.js' defer></script>\n    <script src=\"./helpers/globals.js\"></script>\n    <script src='./helpers/commonTests.js'></script>\n    <script src='https://broken.third-party.site/privacy-protections/storage-blocking/3rdparty.js' defer></script>\n    <script src='https://good.third-party.site/privacy-protections/storage-blocking/3rdparty.js' defer></script>\n    <script src='./main.js' defer></script>\n    <link href='./style.css' rel='stylesheet'></link>\n</head>\n<body>\n    <p><a href=\"../../\">[Home]</a> ↣ <a href=\"../\">[Privacy Protections Tests]</a> ↣ <strong>[Storage Blocking Test Page]</strong></p>\n\n    <p>This page will try to store, and then retrieve, a random number using various storage mechanisms in the browser.</p>\n\n    <p><button id='store'>Store data</button> <button id='retrive'>Retrieve data</button></p>\n\n    <details id='tests' hidden>\n        <summary id='tests-summary'></summary>\n        <ul id='tests-details'>\n        </ul>\n    </details>\n\n    <p><button id='download' disabled>Download the result</button></p>\n\n</body>\n</html>\n"
     },
